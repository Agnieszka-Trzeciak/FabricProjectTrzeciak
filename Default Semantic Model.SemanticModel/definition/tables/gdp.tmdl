table gdp
	lineageTag: ef08dacf-735c-4b5a-a8dc-75f5ae0f720e
	sourceLineageTag: [dbo].[gdp]

	measure 'GDP Growth %' = ```
			
			VAR CurrentYear = MAX(gdp[date])
			VAR CurrentGDP = SUM(gdp[value])
			
			VAR PreviousGDP = 
			    CALCULATE(
			        SUM(gdp[value]),
			        gdp[date] = CurrentYear - 1
			    )
			
			RETURN
			    DIVIDE(CurrentGDP - PreviousGDP, PreviousGDP)
			```
		lineageTag: 1f76fd59-f5fd-4c34-8b6d-391089c941cf

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

